# Backend (NestJS). Server components use API_URL; the browser uses NEXT_PUBLIC_API_URL.
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Product identity. The product name is not final - never hard-code it.
NEXT_PUBLIC_APP_NAME=HotelOS
NEXT_PUBLIC_APP_DOMAIN=hotelos.ng
NEXT_PUBLIC_SUPPORT_EMAIL=hello@hotelos.ng

# Public origin of this app (used for canonical URLs, OpenGraph and the sitemap).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Hotel staff app (signup CTAs link to ${NEXT_PUBLIC_ADMIN_URL}/signup?plan=<code>).
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
