# Backend (NestJS). Server components use API_URL; the browser uses NEXT_PUBLIC_API_URL.
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Product identity. The product name is not final - never hard-code it.
NEXT_PUBLIC_APP_NAME=HotelOS
NEXT_PUBLIC_APP_DOMAIN=hotelos.ng
NEXT_PUBLIC_SUPPORT_EMAIL=hello@hotelos.ng

# Public origin of this app (used for canonical URLs, OpenGraph and the sitemap).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Hotel staff app (signup CTAs link to ${NEXT_PUBLIC_ADMIN_URL}/signup?plan=<code>).
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001

# Shared secret with the backend (server-only; never prefix with NEXT_PUBLIC_). Server-side calls and
# the /api/v1 gateway send X-Proxy-Auth with it plus X-Client-IP with the visitor's address, so the
# backend's per-IP limits count each visitor, not this server. Must equal the backend's value.
TRUSTED_PROXY_SECRET=change-me-to-a-long-random-string

# Optional: a header your host sets with the visitor's address and clients cannot forge
# (e.g. cf-connecting-ip on Cloudflare, x-vercel-forwarded-for on Vercel). Without it the last
# X-Forwarded-For hop (added by your own edge proxy) is used, then X-Real-IP.
# CLIENT_IP_HEADER=cf-connecting-ip
